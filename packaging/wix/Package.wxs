<?xml version="1.0" encoding="utf-8"?>
<!--
  Thumbwright per-machine installer (REQ-REG-8, FUNCTIONAL_SPEC.md 4.2). WiX v7, schema v4.

  Build (normally via scripts/release.ps1 or packaging/wix/build-msi.ps1, which also makes sure the
  WixToolset.UI.wixext extension is available):
    wix build -arch x64 -ext WixToolset.UI.wixext -d Version=0.1.3 -d PackageName=Thumbwright.ShellExtension -d SourceDir=dist -d IconFile=packaging\icons\thumbwright.ico -d LicenseRtf=packaging\wix\license-summary.rtf -d DialogBmp=packaging\wix\dialog.bmp -d BannerBmp=packaging\wix\banner.bmp [-d IncludeSettings=1] Package.wxs -o out.msi

  Defines:
    Version          MSI ProductVersion, major.minor.build (Windows Installer ignores a 4th field).
    PackageName      Identity name of the sparse package SourceDir\Thumbwright.msix; the custom
                     actions that unregister it look it up by this name (build-msi.ps1 reads it
                     from the .msix itself).
    SourceDir        Directory holding the signed payload (dist\).
    IconFile         Absolute path of thumbwright.ico (Programs and Features, Start Menu shortcut).
    LicenseRtf       Absolute path of the licence summary shown by the installer UI.
    DialogBmp        Absolute path of dialog.bmp (493x312, welcome and exit pages).
    BannerBmp        Absolute path of banner.bmp (493x58, inner pages). Both are rendered by
                     generate-art.ps1 from dialog.svg / banner.svg.
    IncludeSettings  Optional. Set to 1 to also ship thumbwright-settings.exe from SourceDir, with
                     its Start Menu shortcut ("Thumbwright Workbench") and the exit-dialog checkbox
                     that opens it.

  Installer UI: WixUI_Minimal (welcome and licence summary on one page, progress, exit). It is
  part of the UI sequence only, so /qn, /qb and Chocolatey installs show nothing. Silent presets
  are the public properties MENU and KIT, stored under HKLM\Software\Thumbwright\Defaults.

  Registration design: see packaging/wix/README.md. In short, the shell registry state is NOT
  authored as MSI Registry rows. It is written and journaled by the DLL's own engine
  (DllRegisterServer, Scope::Machine) through regsvr32 in a deferred, elevated custom action
  that runs after InstallFiles; the matching unregister runs before RemoveFiles. The MSI
  therefore owns files only, and the engine owns every HKLM key it creates, including
  HKLM\Software\Thumbwright\Registration. The one exception is the optional machine-wide
  defaults (HKLM\Software\Thumbwright\Defaults, written only when MENU or KIT is passed), which
  are plain Registry rows in conditional components, so Windows Installer removes them.

  The Windows 11 modern-menu sparse package (Thumbwright.msix) is installed as a file and then
  staged and provisioned for all users by a second pair of deferred actions (RegisterPackage,
  UnregisterPackage); the reasoning is next to those actions and in packaging/wix/README.md.

  The package deliberately has no Thumbwright.ini: its presence next to the binaries is the
  portable-mode marker (REQ-REG-6) and would make an installed copy behave as portable.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Thumbwright"
      Manufacturer="Dailen Gunter"
      Version="$(Version)"
      UpgradeCode="663DEBDD-CC00-4187-B64E-4664E7DA132A"
      Scope="perMachine"
      Language="1033">

    <SummaryInformation Description="Thumbwright thumbnail provider and context menu toolkit" />

    <!-- Same-or-older versions are refused. A newer one removes the old product first
         (running its UnregisterShell), then installs and registers the new files. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Thumbwright is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DailenG/Thumbwright" />
    <!-- Programs and Features icon (packaging/icons/generate.ps1); build-msi.ps1 passes its
         absolute path as IconFile. -->
    <Icon Id="ThumbwrightIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ThumbwrightIcon" />

    <!-- Installer UI (WixUI_Minimal from WixToolset.UI.wixext): one welcome + licence page,
         progress, exit. WixUI is authored in the UI sequence only, so a silent or basic-UI
         install (/qn, /qb, Chocolatey) shows nothing. The licence page shows a short GPL-3.0
         summary (the full text is installed as LICENSE); the checkbox on it only lets setup
         continue, GPL-3.0 needs no acceptance to use the software. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <!-- Thumbwright artwork instead of WiX's default red panel and CD icon
         (generate-art.ps1 renders both from dialog.svg / banner.svg). -->
    <WixVariable Id="WixUIDialogBmp" Value="$(DialogBmp)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(BannerBmp)" />

    <!-- Silent presets, set on the msiexec command line or by Chocolatey package parameters:
           MENU=0     start with the right-click menu off (default: on)
           KIT=<name> starter kit for the Workbench first run: photos, paperwork, design, cad,
                      thumbnails or everything (default: none)
         They are public properties (upper case) and Secure, so they also work in an elevated
         managed install. Neither is ever formatted into a command line: they only select which
         of the Registry-row components below are installed, and the value written for KIT is
         a constant per component, never the property text. Anything else is refused by
         RejectBadMenu / RejectBadKit. -->
    <Property Id="MENU" Secure="yes" />
    <Property Id="KIT" Secure="yes" />

    <!-- The install directory Id is deliberately MIXED CASE (audit P-1, P-2). Windows Installer
         treats a property whose name has no lower-case letter as PUBLIC: it can be set on the
         msiexec command line (msiexec /i ... INSTALLFOLDER=...), and the value is then pasted,
         unescaped, into the PowerShell command lines of the custom actions below and decides
         where a SYSTEM-run regsvr32 loads the DLL from. A private (mixed-case) property cannot be
         overridden from the command line, so the location is always
         [ProgramFiles64Folder]Thumbwright\ . Never rename it to an all-upper-case Id;
         scripts/test-install.ps1 -DryRun fails if any public property or directory is referenced
         by an action. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="InstallFolder" Name="Thumbwright" />
    </StandardDirectory>

    <Feature Id="Main" Title="Thumbwright" AllowAbsent="no">
      <ComponentGroupRef Id="ProductFiles" />
    </Feature>

    <ComponentGroup Id="ProductFiles" Directory="InstallFolder">
      <Component Id="ShellDll">
        <File Id="ShellDllFile" Name="thumbwright_shell.dll" Source="$(SourceDir)\thumbwright_shell.dll" KeyPath="yes" />
      </Component>
      <Component Id="WorkerExe">
        <File Id="WorkerExeFile" Name="tw-worker.exe" Source="$(SourceDir)\tw-worker.exe" KeyPath="yes" />
      </Component>
      <Component Id="TwctlExe">
        <File Id="TwctlExeFile" Name="twctl.exe" Source="$(SourceDir)\twctl.exe" KeyPath="yes" />
      </Component>
      <Component Id="SparsePackage">
        <File Id="SparsePackageFile" Name="Thumbwright.msix" Source="$(SourceDir)\Thumbwright.msix" KeyPath="yes" />
      </Component>
<?ifdef IncludeSettings?>
      <Component Id="SettingsExe">
        <!-- The Start Menu entry for all users (Programs). It is a child of the file, so its
             target is [#SettingsExeFile], the component's key path is the exe itself (no
             registry key path needed for an all-users shortcut), and Windows Installer
             removes it on uninstall. -->
        <File Id="SettingsExeFile" Name="thumbwright-settings.exe" Source="$(SourceDir)\thumbwright-settings.exe" KeyPath="yes">
          <Shortcut Id="WorkbenchShortcut" Directory="ProgramMenuFolder" Name="Thumbwright Workbench"
              Description="Choose the file types and right-click tools Thumbwright uses"
              Icon="ThumbwrightIcon" WorkingDirectory="InstallFolder" />
        </File>
      </Component>
<?endif?>
      <Component Id="LicenseFile">
        <File Id="LicenseFileFile" Name="LICENSE" Source="$(SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyLicensesFile">
        <File Id="ThirdPartyLicensesFileFile" Name="THIRD_PARTY_LICENSES.md" Source="$(SourceDir)\THIRD_PARTY_LICENSES.md" KeyPath="yes" />
      </Component>

      <!-- Machine-wide defaults for users who have no settings of their own yet (read by
           Settings::machine_defaults in tw-core). Each component is installed only when its
           property selects it, so an install without MENU and KIT writes nothing. MENU=0 writes
           MenuEnabled=0 (the same value name and meaning as the per-user setting). KIT writes
           StarterKit with the kit's own constant name. Passing the property again is part of
           a repair, modify or upgrade: Windows Installer removes a conditional component whose
           condition is no longer true. -->
      <Component Id="DefaultMenuOff" Condition='MENU = "0"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="MenuEnabled" Type="integer" Value="0" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
      <!-- One component per kit, each with its own GUID: the six write the same value, and
           their conditions are mutually exclusive (RejectBadKit refuses anything else). -->
      <Component Id="DefaultKitPhotos" Guid="F96C60AC-2801-476B-93F8-9986035BDCEA" Condition='KIT ~= "photos"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="StarterKit" Type="string" Value="photos" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
      <Component Id="DefaultKitPaperwork" Guid="FD85B626-470E-4245-98B2-8FE06662817F" Condition='KIT ~= "paperwork"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="StarterKit" Type="string" Value="paperwork" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
      <Component Id="DefaultKitDesign" Guid="840A4A7D-62E5-47C6-B8DB-5D59B6545D31" Condition='KIT ~= "design"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="StarterKit" Type="string" Value="design" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
      <Component Id="DefaultKitCad" Guid="B4186434-C91D-4F86-9864-3DE42A2D3988" Condition='KIT ~= "cad"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="StarterKit" Type="string" Value="cad" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
      <Component Id="DefaultKitThumbnails" Guid="56A376E0-4286-4232-86B0-9A937AAF3917" Condition='KIT ~= "thumbnails"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="StarterKit" Type="string" Value="thumbnails" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
      <Component Id="DefaultKitEverything" Guid="17ABE851-B718-434D-BFA7-39CD334E6CEB" Condition='KIT ~= "everything"'>
        <RegistryValue Root="HKLM" Key="Software\Thumbwright\Defaults" Name="StarterKit" Type="string" Value="everything" KeyPath="yes" />
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Thumbwright\Defaults" />
      </Component>
    </ComponentGroup>

    <!-- Deferred actions run in the elevated installer service (LocalSystem), so they cannot
         read session properties at run time. For an EXE-type action, Windows Installer
         formats ExeCommand when it writes the script, so [InstallFolder] below is the
         resolved install path.

         regsvr32 comes from System64Folder (the 64-bit regsvr32): the DLL is x64 and its
         HKLM writes must land in the 64-bit registry view. Exit code 0 is DllRegisterServer
         returning S_OK. -->
    <CustomAction Id="RegisterShell" Directory="InstallFolder"
        Execute="deferred" Impersonate="no" Return="check"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[InstallFolder]thumbwright_shell.dll&quot;" />

    <!-- Rollback of a failed install/repair/upgrade: undo the registration while the files are
         still present. Rollback scripts run in reverse order, so this runs before InstallFiles
         is rolled back. Best effort: a failure here cannot be recovered from. -->
    <CustomAction Id="RegisterShellRollback" Directory="InstallFolder"
        Execute="rollback" Impersonate="no" Return="ignore"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[InstallFolder]thumbwright_shell.dll&quot;" />

    <!-- Uninstall, and the removal half of a major upgrade. Return="ignore": a failing
         unregistration (for example a corrupt journal) must not make the product
         impossible to uninstall; regsvr32's exit code is in the verbose MSI log, and
         scripts/test-install.ps1 fails on any residue. -->
    <CustomAction Id="UnregisterShell" Directory="InstallFolder"
        Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[InstallFolder]thumbwright_shell.dll&quot;" />

    <!-- Windows 11 modern menu: the sparse package is registered for ALL users, by the route
         the Microsoft documentation gives a machine-wide installer ("Grant package identity by
         packaging with external location", "Register the identity package in your installer",
         Per-Machine): stage the package with the install directory as its external location,
         then provision it. Provisioning makes Windows register the package for every user at
         their next sign-in. The deferred actions run as LocalSystem and Windows cannot register
         a package for LocalSystem, so nobody has the verb until their next sign-in. The
         per-user route, Add-AppxPackage -ExternalLocation, would cover one user only. See
         packaging/wix/README.md.

         Each action is one short Windows PowerShell 5.1 (64-bit) -Command, not a script file, so
         nothing has to be signed or pass the execution policy. Each fits the 255 characters the
         CustomAction.Target column allows (ICE03 warns beyond that), which is why staging,
         provisioning and removal are separate actions. The commands contain no braces or double
         quotes, which Windows Installer's formatted text and the command line would otherwise
         treat specially. powershell.exe is not quoted: its path under [System64Folder] has no
         spaces.

         Failure is not fatal (Return="ignore"): the thumbnail provider is the product, the verb
         is an addition, and an unsigned development package (release.ps1 -SkipSign) cannot be
         registered at all. The exit codes are in the verbose MSI log, and
         scripts/test-install.ps1 checks that a signed release did register. -->
    <?define PowerShell="[System64Folder]WindowsPowerShell\v1.0\powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command" ?>
    <?define CmdDeprovision="Get-AppxProvisionedPackage -Online | Where-Object DisplayName -eq '$(PackageName)' | Remove-AppxProvisionedPackage -Online" ?>
    <?define CmdRemove="Get-AppxPackage -AllUsers -Name '$(PackageName)' | Remove-AppxPackage -AllUsers" ?>
    <?define CmdStage="Add-AppxPackage -Stage '[InstallFolder]Thumbwright.msix' -ExternalLocation ('[InstallFolder]'.TrimEnd('\'))" ?>
    <?define CmdRegisterUser="Add-AppxPackage -Path '[InstallFolder]Thumbwright.msix' -ExternalLocation ('[InstallFolder]'.TrimEnd('\'))" ?>
    <?define CmdProvision="Add-AppxProvisionedPackage -Online -PackagePath '[InstallFolder]Thumbwright.msix' -SkipLicense" ?>

    <!-- Removal: deprovision (so nobody new is registered), then remove for every user, which
         also stops the package's COM surrogate that holds the DLL. They run on uninstall and
         on the removal half of a major upgrade, and also on install and repair, where they
         clear an earlier registration of the same package first (Add-AppxPackage refuses a
         version that is already registered); on a clean machine they find nothing. -->
    <CustomAction Id="DeprovisionPackage" Directory="InstallFolder"
        Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdDeprovision)&quot;" />
    <CustomAction Id="RemovePackage" Directory="InstallFolder"
        Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdRemove)&quot;" />

    <CustomAction Id="StagePackage" Directory="InstallFolder"
        Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdStage)&quot;" />
    <CustomAction Id="ProvisionPackage" Directory="InstallFolder"
        Execute="deferred" Impersonate="no" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdProvision)&quot;" />

    <!-- Rollback of a failed install: undo provisioning, then staging (rollback scripts run in
         reverse order). Best effort. -->
    <CustomAction Id="StagePackageRollback" Directory="InstallFolder"
        Execute="rollback" Impersonate="no" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdRemove)&quot;" />
    <CustomAction Id="ProvisionPackageRollback" Directory="InstallFolder"
        Execute="rollback" Impersonate="no" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdDeprovision)&quot;" />

    <!-- The user who ran the installer gets the modern-menu verb immediately, by the per-user
         route the sparse-package documentation gives installers: register the .msix with the
         install directory as its external location, for that user (Add-AppxPackage registers
         for the account that runs it). Impersonated, so it runs as that user, not LocalSystem
         (which Windows cannot register a package for); it needs no elevation. In a silent
         deployment with no interactive user the action fails and is ignored, and every user
         still gets the verb at their next sign-in (the provisioned family), so nothing
         depends on it. If the same version is already registered for that user (a repair),
         Add-AppxPackage fails and the action is ignored; the earlier registration stands. -->
    <CustomAction Id="RegisterPackageForUser" Directory="InstallFolder"
        Execute="deferred" Impersonate="yes" Return="ignore"
        ExeCommand="$(PowerShell) &quot;$(CmdRegisterUser)&quot;" />

    <CustomAction Id="RejectUnsafeInstallFolder" Error="The install folder must not contain a single quote (')." />

    <CustomAction Id="RejectBadMenu" Error="MENU must be 0 (start with the right-click menu off) or 1 (the default)." />
    <CustomAction Id="RejectBadKit" Error="KIT must be one of: photos, paperwork, design, cad, thumbnails, everything." />
<?ifdef IncludeSettings?>

    <!-- Exit dialog checkbox "Open Thumbwright Workbench". The installer UI runs in the client
         process; when msiexec was started from an elevated prompt that process is elevated, and
         a packaged exe launched elevated writes its settings into the wrong (virtualized) HKCU.
         Asking explorer.exe to open the file hands the launch to the user's own, unelevated
         shell, so the Workbench always starts as the signed-in user. Immediate, not deferred,
         and not waited for (asyncNoWait); formats only private properties. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Thumbwright Workbench" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchWorkbench" Directory="InstallFolder"
        Execute="immediate" Return="asyncNoWait"
        ExeCommand="&quot;[WindowsFolder]explorer.exe&quot; &quot;[InstallFolder]thumbwright-settings.exe&quot;" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWorkbench"
          Condition='WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed' />
    </UI>
<?endif?>

    <InstallExecuteSequence>
      <!-- Remove the package first, so none of our code is loaded when the DLL is unregistered
           and its files are deleted: deprovision, remove, unregister the DLL, remove files.
           (On install this runs before InstallFiles, which is when stale state must go.) -->
      <Custom Action="DeprovisionPackage" Before="RemovePackage" />
      <Custom Action="RemovePackage" Before="UnregisterShell" />
      <!-- Unregister while the DLL is still on disk (regsvr32 /u loads it). -->
      <Custom Action="UnregisterShell" Before="RemoveFiles" Condition='REMOVE="ALL"' />
      <!-- Install, repair (/fa) and modify register again; DllRegisterServer first undoes
           any previous registration of its own, so repeats never stack. -->
      <Custom Action="RegisterShellRollback" Before="RegisterShell" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="RegisterShell" After="InstallFiles" Condition='NOT (REMOVE="ALL")' />
      <!-- The package is staged and provisioned once the files, including Thumbwright.msix and
           the external location's content, are in place. -->
      <Custom Action="StagePackageRollback" Before="StagePackage" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="StagePackage" After="RegisterShell" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="ProvisionPackage" After="StagePackage" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="ProvisionPackageRollback" Before="ProvisionPackage" Condition='NOT (REMOVE="ALL")' />
      <Custom Action="RegisterPackageForUser" After="ProvisionPackage" Condition='NOT (REMOVE="ALL")' />
      <!-- Defence in depth for the PowerShell actions: their paths sit in single-quoted strings
           that cannot be escaped here, so refuse an install directory containing a single quote
           (reachable only through a transform or a relocated Program Files). -->
      <Custom Action="RejectUnsafeInstallFolder" After="CostFinalize" Condition='NOT (REMOVE="ALL") AND InstallFolder &gt;&lt; "&apos;"' />
      <Custom Action="RejectBadMenu" After="RejectUnsafeInstallFolder" Condition='NOT (REMOVE="ALL") AND MENU AND MENU &lt;&gt; "0" AND MENU &lt;&gt; "1"' />
      <Custom Action="RejectBadKit" After="RejectBadMenu" Condition='NOT (REMOVE="ALL") AND KIT AND NOT (KIT ~= "photos" OR KIT ~= "paperwork" OR KIT ~= "design" OR KIT ~= "cad" OR KIT ~= "thumbnails" OR KIT ~= "everything")' />
    </InstallExecuteSequence>
  </Package>
</Wix>
